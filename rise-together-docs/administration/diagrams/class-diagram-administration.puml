@startuml
skinparam linetype ortho

title Administration Bounded Context

package "domain" {
  class SkillManagementAggregate {
    +addSkill()
    +addSynonym()
    +addRelationship()
    +deactivateSkill()
  }

  class CategoryManagementAggregate {
    +createCategory()
    +updateCategory()
    +deleteCategory()
  }

  class HelpCenterAggregate {
    +createArticle()
    +publishArticle()
    +search()
  }

  class OnboardingFlowAggregate {
    +createFlow()
    +addStep()
    +reorderSteps()
    +activateFlow()
  }

  class AuditLogAggregate {
    +log()
    +query()
  }
}

package "valueobjects" {
  class AdminUserId
  class AuditEntry
  class OnboardingFlowId
  class OnboardingStep
  class StepType <<enumeration>>
  class HelpArticleId
  class HelpCategory
}

package "events" {
  class SkillManagementEvent
  class HelpArticlePublishedEvent
  class AuditLogEntryEvent
}

SkillManagementAggregate --> AdminUserId
CategoryManagementAggregate --> AdminUserId
HelpCenterAggregate --> HelpArticleId
HelpCenterAggregate --> HelpCategory
OnboardingFlowAggregate --> OnboardingFlowId
OnboardingFlowAggregate --> OnboardingStep
OnboardingFlowAggregate --> StepType
AuditLogAggregate --> AuditEntry

AuditLogAggregate ..> AuditLogEntryEvent : records

@enduml