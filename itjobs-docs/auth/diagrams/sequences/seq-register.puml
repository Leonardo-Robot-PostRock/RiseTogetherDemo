@startuml ITJobs - Secuencia: Registro de Usuario

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Candidato" as U
participant "AuthController\n<<REST>>" as CTRL
participant "RegisterUserUseCase\n<<Use Case>>" as UC
participant "Email\n<<Value Object>>" as EMAIL
participant "QueryUserPort\n<<Out Port>>" as QUERY
participant "PasswordEncoderPort\n<<Out Port>>" as ENC
participant "UserAggregate\n<<Aggregate>>" as AGG
participant "SaveUserPort\n<<Out Port>>" as SAVE
participant "LoadTermsDocumentPort\n<<Out Port>>" as TERMS
participant "SaveTermsAcceptancePort\n<<Out Port>>" as ACC
participant "DomainEventPublisher\n<<Out Port>>" as PUB

U -> CTRL : POST /api/v1/auth/register\n{username, email, password}
activate CTRL

CTRL -> CTRL : Map DTO → RegisterUserCommand

CTRL -> UC : execute(command)
activate UC

' Validación de Value Objects
UC -> EMAIL : Email.of(command.email())
activate EMAIL
EMAIL --> UC : Email (normalizado)
deactivate EMAIL

UC -> UC : Username.of(command.username())

' Verificar email duplicado (query side)
UC -> QUERY : existsByEmail(email)
activate QUERY
QUERY --> UC : false
deactivate QUERY

note right of QUERY
  CQRS — query side.
  Solo verifica duplicado de email.
  No instancia UserAggregate.
end note

' Hash de password
UC -> ENC : encode(rawPassword)
activate ENC
ENC --> UC : "$2a$10$hashed..."
deactivate ENC

' Crear agregado
UC -> AGG : UserAggregate.create(username, email, hashedPassword)
activate AGG
AGG -> AGG : Assign ROLE_USER
AGG -> AGG : recordEvent(UserRegisteredEvent)
AGG --> UC : UserAggregate
deactivate AGG

' Persistir
UC -> SAVE : save(user)
activate SAVE
SAVE --> UC : savedUser
deactivate SAVE

' Registrar aceptación de términos
UC -> TERMS : findLatestByType(TERMS_OF_SERVICE)
activate TERMS
TERMS --> UC : TermsDocument
deactivate TERMS

UC -> UC : TermsAcceptance.create(userId, documentId)

UC -> ACC : save(acceptance)
activate ACC
ACC --> UC : void
deactivate ACC

' Publicar eventos
UC -> PUB : publishAll(savedUser.pullDomainEvents())
activate PUB
PUB --> UC : void
deactivate PUB

' Preparar respuesta
UC -> UC : Map → RegisterUserResponse
UC --> CTRL : RegisterUserResponse
deactivate UC

CTRL -> CTRL : Map → AuthResponse
CTRL --> U : 201 Created\n{userId, username, email}
deactivate CTRL

@enduml
