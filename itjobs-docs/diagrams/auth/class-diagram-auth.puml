@startuml ClassDiagramAuth

title Authentication — Aggregate, Value Objects, Events y Ports

skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #888888

' ─── Aggregate ───────────────────────────────
package "domain.aggregate" #E8F5E9 {
    class UserAggregate <<Aggregate>> {
        - id : UserId
        - username : Username
        - email : Email
        - password : HashedPassword
        - googleSub : GoogleSub
        - active : boolean
        - emailVerified : boolean
        - verificationToken : VerificationToken
        - roles : List<String>
        - createdAt : Timestamp
        - updatedAt : Timestamp
        --
        + {static} create() : UserAggregate
        + {static} createGoogleUser() : UserAggregate
        + {static} reconstitute() : UserAggregate
        --
        + activate()
        + deactivate()
        + verifyEmail()
        + changePassword(hashed)
        + linkGoogleAccount(sub)
        + updateEmail(email)
        + addRole(role)
        + pullDomainEvents() : List<DomainEvent>
    }

    class TermsDocument <<Aggregate>> {
        - id : TermsDocumentId
        - type : TermsType
        - version : String
        - content : String
        - publishedAt : Instant
        --
        + {static} create() : TermsDocument
        + {static} reconstitute() : TermsDocument
    }
}

' ─── Entity ──────────────────────────────────
package "domain.entity" #E8F5E9 {
    class TermsAcceptance <<Entity>> {
        - id : TermsAcceptanceId
        - userId : UserId
        - documentId : TermsDocumentId
        - acceptedAt : Instant
        --
        + {static} create() : TermsAcceptance
        + {static} reconstitute() : TermsAcceptance
    }
}

' ─── Value Objects ───────────────────────────
package "domain.valueobjects" #DCEDC8 {
    class Username <<ValueObject>> {
        - value : String
        + of(raw) : Username
    }
    class HashedPassword <<ValueObject>> {
        - value : String
        + fromHash(hash) : HashedPassword
    }
    class GoogleSub <<ValueObject>> {
        - value : String
        + of(raw) : GoogleSub
    }
    class VerificationToken <<ValueObject>> {
        - token : String
        - expiresAt : Instant
        + of(token, expiresAt) : VerificationToken
        + matches(token) : boolean
        + isExpired() : boolean
    }
    class PasswordResetToken <<ValueObject>> {
        - token : String
        + generate() : PasswordResetToken
        + value() : String
    }
    class UserStatus <<ValueObject>> {
        ACTIVE
        INACTIVE
    }
}

' ─── Query Model (CQRS) ──────────────────────
package "application.query" #FFF9C4 {
    class UserView <<Record>> {
        id : UserId
        username : String
        email : String
        hashedPassword : HashedPassword
        active : boolean
        emailVerified : boolean
        roles : List<String>
    }
}

' ─── Domain Events ───────────────────────────
package "domain.event" #FFF3E0 {
    class UserRegisteredEvent <<Event>> {
        - userId : String
        - email : String
    }
    class UserActivatedEvent <<Event>> {
        - email : String
    }
    class UserDeactivatedEvent <<Event>> {
        - email : String
    }
    class EmailVerifiedEvent <<Event>> {
        - userId : String
        - email : String
    }
    class PasswordResetRequestedEvent <<Event>> {
        - email : String
        - resetToken : String
    }
    class EmailChangedEvent <<Event>> {
        - userId : String
        - newEmail : String
    }
    class GoogleAccountLinkedEvent <<Event>> {
        - userId : String
        - googleSub : String
    }
    class PasswordChangedEvent <<Event>> {
        - userId : String
    }
}

' ─── Domain Service ──────────────────────────
package "domain.service" #FFF9C4 {
    class CredentialsVerifier <<Domain Service>> {
        + verifyCredentials(user, rawPwd, encoder)
    }
}

' ─── Ports IN (Application Layer) ───────────
package "application.ports.in" #C8E6C9 {
    interface RegisterUserPort
    interface LoginPort
    interface GoogleAuthPort
    interface VerifyEmailPort
    interface ChangePasswordPort
    interface ForgotPasswordPort
    interface ResendVerificationPort
    interface RefreshTokenPort
    interface DeleteExpiredUnverifiedUsersPort
}

' ─── Ports OUT (Application Layer) ──────────
package "application.ports.out" #A5D6A7 {
    interface LoadUserPort {
        ' command side — returns UserAggregate
        + findByEmail(email) : Optional<UserAggregate>
        + findById(id) : Optional<UserAggregate>
    }
    interface QueryUserPort {
        ' query side — returns UserView (projection)
        + findByEmail(email) : Optional<UserView>
        + findById(id) : Optional<UserView>
        + existsByEmail(email) : boolean
        + findUnverifiedUserIdsBefore(instant) : List<UserId>
    }
    interface SaveUserPort {
        + save(user) : UserAggregate
    }
    interface DeleteUserPort {
        + delete(id) : void
    }
    interface PasswordEncoderPort {
        + encode(raw) : String
        + matches(raw, hash) : boolean
    }
    interface TokenGeneratorPort {
        + generateAccessToken(userId, roles) : String
        + generateRefreshToken(userId) : String
    }
    interface VerificationTokenValidatorPort {
        + validate(token, providedToken)
    }
    interface EmailSenderPort {
        + sendEmail(to, subject, body) : void
    }
    interface LoadTermsDocumentPort {
        + findLatestByType(type) : Optional<TermsDocument>
    }
    interface SaveTermsAcceptancePort {
        + save(acceptance) : void
    }
}

' ─── Relations — Aggregate ───────────────────
UserAggregate *-- Username
UserAggregate *-- HashedPassword
UserAggregate *-- GoogleSub
UserAggregate *-- VerificationToken

UserAggregate ..> UserRegisteredEvent   : records
UserAggregate ..> UserActivatedEvent    : records
UserAggregate ..> UserDeactivatedEvent  : records
UserAggregate ..> EmailVerifiedEvent    : records
UserAggregate ..> EmailChangedEvent     : records
UserAggregate ..> GoogleAccountLinkedEvent : records
UserAggregate ..> PasswordChangedEvent  : records

CredentialsVerifier --> PasswordEncoderPort

' ─── CQRS note ───────────────────────────────
note top of QueryUserPort
  CQRS — query side
  Devuelve UserView (projection).
  No instancia UserAggregate.
  Usado por use cases de solo lectura:
  Login, ForgotPassword, RefreshToken,
  DeleteExpiredUnverified (find phase).
end note

note top of LoadUserPort
  CQRS — command side
  Devuelve UserAggregate completo.
  Usado por use cases que mutan estado:
  ChangePassword, VerifyEmail,
  GoogleAuth, ResendVerification.
end note

' ─── Email adapters note ─────────────────────
note right of EmailSenderPort
  SmtpEmailSenderAdapter
    @ConditionalOnProperty(spring.mail.host)
  NoOpEmailSenderAdapter
    @ConditionalOnMissingBean(EmailSenderPort)
    → logs WARN, descarta el envío
end note

@enduml

