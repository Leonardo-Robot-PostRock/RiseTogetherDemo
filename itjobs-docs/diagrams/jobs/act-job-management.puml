@startuml ITJobs - Actividad: Gestión de Oferta de Empleo

skinparam activityBackgroundColor #FEFECE
skinparam activityBorderColor #333333
skinparam decisionBackgroundColor #FFFFDD

start

:Empleador/Reclutador completa formulario de oferta;
note right
  title, description, company,
  salary, employmentType,
  skills, categories
end note

:Validar datos de entrada;
note right
  Jakarta Validation + Domain Validation
  (Value Objects)
end note

if (Datos válidos?) then (no)
  :Retornar error 400 Bad Request;
  stop
endif

:Crear JobAggregate;
note right
  JobAggregate.create(...)
  status = OPEN
end note

:Persistir en base de datos;
note right
  SaveUserPort → JPA → MySQL
end note

:Publicar dominio evento;
note right
  DomainEventPublisher
  → JobCreatedEvent
end note

:Retornar 201 Created;

partition "Gestión posterior" {
  :Oferta visible para candidatos;
  
  fork
    :Recibe postulaciones;
  fork again
    :Empleador cierra oferta;
    note right
      job.close()
      status: OPEN → CLOSED
      JobClosedEvent
    end note
  fork again
    :Empleador desactiva oferta;
    note right
      job.deactivate()
      status: OPEN → INACTIVE
      JobDeactivatedEvent
    end note
  end fork
}

stop

@enduml
