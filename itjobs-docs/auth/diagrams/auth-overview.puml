@startuml AuthOverview

title Authentication — Capas Hexagonales (visión de componentes)

left to right direction

skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #AAAAAA
}

' ── Fila AuthController ──────────────────────────────────────────
package "REST Adapters  (Driving)" #E8EAF6 {
    rectangle "AuthController\n/api/v1/auth/**" as CTRL1
    rectangle "AccountController\n/api/v1/account/**" as CTRL2
}

package "Ports IN — AuthController" #C8E6C9 {
    rectangle "RegisterUserPort\nLoginPort\nGoogleAuthPort\nVerifyEmailPort\nForgotPasswordPort\nResendVerificationPort\nRefreshTokenPort\nDeleteExpiredUnverifiedUsersPort" as PORTS_AUTH
}

package "Use Cases — AuthController" #DCEDC8 {
    rectangle "RegisterUserUseCase\nLoginUseCase\nGoogleAuthUseCase\nVerifyEmailUseCase\nForgotPasswordUseCase\nResendVerificationUseCase\nRefreshTokenUseCase\nDeleteExpiredUnverifiedUsersUseCase" as UCS_AUTH
}

' ── Fila AccountController ───────────────────────────────────────
package "Ports IN — AccountController" #C8E6C9 {
    rectangle "ChangePasswordPort" as PORTS_ACC
}

package "Use Cases — AccountController" #DCEDC8 {
    rectangle "ChangePasswordUseCase" as UCS_ACC
}

' ── Query Model (CQRS) ───────────────────────────────────────────
package "Query Model" #FFF9C4 {
    rectangle "UserView\n(projection — record)" as UV
}

' ── Capas compartidas ────────────────────────────────────────────
package "Domain" #FFF3E0 {
    rectangle "UserAggregate\nTermsDocument  TermsAcceptance\nCredentialsVerifier" as DOM
}

package "Ports OUT — command side" #A5D6A7 {
    rectangle "LoadUserPort  → UserAggregate\nSaveUserPort  DeleteUserPort\nPasswordEncoderPort\nTokenGeneratorPort\nVerificationTokenValidatorPort\nLoadTermsDocumentPort\nSaveTermsAcceptancePort\nDomainEventPublisher" as PORTS_OUT_CMD
}

package "Ports OUT — query side" #B9F6CA {
    rectangle "QueryUserPort  → UserView\n(leer sin instanciar UserAggregate)" as PORTS_OUT_QRY
}

package "Infrastructure Adapters  (Driven)" #F3E5F5 {
    rectangle "LoadUserPortAdapter (JPA)  QueryUserPortAdapter (JPA)\nSaveUserPortAdapter (JPA)  JpaTermsRepositoryAdapter\nBCryptPasswordEncoderAdapter  JwtTokenGeneratorAdapter\nVerificationTokenValidatorAdapter\nSpringDomainEventPublisher\nSmtpEmailSenderAdapter  NoOpEmailSenderAdapter" as ADAPTERS
}

' ── Relaciones ───────────────────────────────────────────────────
CTRL1      --> PORTS_AUTH      : invoca
CTRL2      --> PORTS_ACC       : invoca

PORTS_AUTH --> UCS_AUTH        : implementado por
PORTS_ACC  --> UCS_ACC         : implementado por

UCS_AUTH   --> DOM             : usa
UCS_ACC    --> DOM             : usa

UCS_AUTH   --> PORTS_OUT_CMD   : invoca (write)
UCS_AUTH   --> PORTS_OUT_QRY   : invoca (read-only)
UCS_ACC    --> PORTS_OUT_CMD   : invoca (write)

PORTS_OUT_QRY --> UV           : devuelve
PORTS_OUT_CMD --> ADAPTERS     : implementado por
PORTS_OUT_QRY --> ADAPTERS     : implementado por

note bottom
  CQRS:
    LoadUserPort (command) → UserAggregate (para mutaciones)
    QueryUserPort (query)  → UserView (para lecturas)
  Email:
    SmtpEmailSenderAdapter  @ConditionalOnProperty(spring.mail.host)
    NoOpEmailSenderAdapter  @ConditionalOnMissingBean(EmailSenderPort) — fallback
  Diagramas de detalle:
    uc-*.puml              → use cases individuales con sus puertos
    seq-*.puml             → flujos de secuencia completos
end note

@enduml
