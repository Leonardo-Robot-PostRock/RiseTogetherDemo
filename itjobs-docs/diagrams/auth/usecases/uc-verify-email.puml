@startuml UcVerifyEmail

title Authentication — VerifyEmailUseCase

skinparam activityBackgroundColor #FAFAFA
skinparam activityBorderColor #888888
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityArrowColor #555555
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

start

:UserId.of(command.userId());

:LoadUserPort.findById(userId);
note right
  CQRS — command side.
  Devuelve Optional<UserAggregate>.
end note

if (¿usuario encontrado?) then (no)
  #FF8A80:throw NotFoundException;
  stop
endif

:VerificationTokenValidatorPort\n.validate(user.verificationToken, command.token());
note right
  Lanza excepción si:
  · token no coincide
  · token expirado (isExpired = true)
end note

:user.verifyEmail();
note right
  emailVerified = true.
  Registra EmailVerifiedEvent.
end note

:SaveUserPort.save(user);

:DomainEventPublisher\n.publish(EmailVerifiedEvent);
note right
  EmailVerifiedEventListener
  puede activar al usuario.
end note

stop

@enduml
