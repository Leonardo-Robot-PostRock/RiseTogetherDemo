@startuml ITJobs - Secuencia: Reenvío de Verificación de Email

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Usuario" as U
participant "AuthController\n<<REST>>" as CTRL
participant "ResendVerificationUseCase\n<<Use Case>>" as UC
participant "LoadUserPort\n<<Out Port>>" as LOAD
participant "UserAggregate\n<<Aggregate>>" as AGG
participant "SaveUserPort\n<<Out Port>>" as SAVE
participant "EmailSenderPort\n<<Out Port>>" as EMAIL

U -> CTRL : POST /api/v1/auth/resend-verification\n{userId}
activate CTRL

CTRL -> CTRL : Map DTO → ResendVerificationCommand

CTRL -> UC : execute(command)
activate UC

' Cargar usuario (command side)
UC -> LOAD : findById(userId)
activate LOAD
LOAD --> UC : Optional<UserAggregate>
deactivate LOAD

UC -> UC : orElseThrow()\nUsuario no encontrado → 404

note right of LOAD
  CQRS — command side.
  Devuelve UserAggregate para poder
  regenerar y persistir el token.
end note

' Validar que no está ya verificado
UC -> AGG : user.isEmailVerified()
activate AGG
AGG --> UC : false
deactivate AGG

note right of AGG
  Si emailVerified = true →
  EmailAlreadyVerifiedException
end note

' Regenerar token de verificación
UC -> AGG : regenerar VerificationToken
activate AGG
AGG -> AGG : new VerificationToken(uuid, now + 24h)
AGG --> UC : (token actualizado)
deactivate AGG

' Persistir usuario actualizado
UC -> SAVE : save(user)
activate SAVE
SAVE --> UC : void
deactivate SAVE

' Enviar email
UC -> EMAIL : sendEmail(user.email, "Verificá tu email", body con token)
activate EMAIL

note right of EMAIL
  SmtpEmailSenderAdapter si spring.mail.host está configurado.
  NoOpEmailSenderAdapter como fallback (logs WARN).
  En ningún caso el use case lanza excepción por mail.
end note

EMAIL --> UC : void
deactivate EMAIL

UC --> CTRL : void
deactivate UC

CTRL --> U : 200 OK
deactivate CTRL

@enduml

