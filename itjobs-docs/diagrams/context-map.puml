@startuml ContextMap

title ITJobs - Context Map

left footer Leyenda: ..> USA Evento | --> DEPENDE

package "Shared" {
    component [DomainEvent]
}

package "Authentication" {
    component [UserAggregate]
    component [RegisterUserUseCase]
    component [LoginUseCase]
    component [CredentialsVerifier]
}

package "Jobs" {
    component [JobAggregate]
    component [CreateJobUseCase]
    component [SearchJobsUseCase]
}

package "Applications" {
    component [ApplicationAggregate]
    component [ApplyToJobUseCase]
}

package "Profiles" {
    component [CandidateAggregate]
    component [EmployerAggregate]
    component [RecruiterAggregate]
}

package "Administration" {
    component [CategoryAggregate]
    component [UserManagementUseCase]
}

package "Moderation" {
    component [ContentReportAggregate]
    component [ModerationUseCase]
}

' Domain Events publishes
UserAggregate ..> [DomainEvent] : publica eventos
JobAggregate ..> [DomainEvent] : publica eventos
ApplicationAggregate ..> [DomainEvent] : publica eventos
ContentReportAggregate ..> [DomainEvent] : publica eventos

' Authentication relations
RegisterUserUseCase --> [JobAggregate] : necesita para preparar respuesta
CredentialsVerifier --> [PasswordEncoderPort] : verifica password

' Jobs relations (IMPLEMENTADO en codigo)
CreateJobUseCase --> [JobAggregate] : crea ofertas
SearchJobsUseCase --> [JobAggregate] : busca ofertas

' Applications relations
ApplyToJobUseCase --> [CandidateAggregate] : necesita candidato
ApplyToJobUseCase --> [JobAggregate] : necesita job

' Profiles relations
CandidateAggregate ..> [DomainEvent] : publicar eventos
EmployerAggregate --> [JobAggregate] : crea y gestiona ofertas
RecruiterAggregate --> [JobAggregate] : gestiona ofertas

' Administration
CategoryAggregate --> [JobAggregate] : categoriza ofertas
UserManagementUseCase --> [UserAggregate] : gestiona usuarios

' Moderation
ModerationUseCase --> [JobAggregate] : reporta contenido
ModerationUseCase --> [ApplicationAggregate] : reporta postulaciones

@enduml