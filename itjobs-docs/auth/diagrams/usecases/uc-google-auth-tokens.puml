@startuml UcGoogleAuthTokens

title GoogleAuthUseCase — Fase 3: Emitir tokens JWT

skinparam activityBackgroundColor #FAFAFA
skinparam activityBorderColor #888888
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityArrowColor #555555
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

start

:TokenGeneratorPort\n.generateAccessToken(userId, roles);
note right
  Retorna JWT firmado.
  Expira en 15 min.
end note

:TokenGeneratorPort\n.generateRefreshToken(userId);
note right
  Retorna JWT firmado.
  Expira en 7 días.
  Permite renovar el accessToken
  sin re-login.
end note

:Retornar AuthTokenResponse\n(accessToken, refreshToken);
note right
  Esta fase se ejecuta siempre,
  independientemente del camino
  tomado en las fases 1 y 2.
end note

stop

@enduml
