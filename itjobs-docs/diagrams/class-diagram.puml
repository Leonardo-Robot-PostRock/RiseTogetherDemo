@startuml ITJobsClassDiagram

title ITJobs - Diagrama de Clases DDD

left footer Leyenda: Composicion (*) | Herencia (<|--) | Realizacion (<|..) | Dependencia (<--)

package "shared" {

    class DomainEvent <<abstract>> {
        - occurredOn : Instant
    }

    class Email <<ValueObject>> {
        - value : String
    }

    class UserId <<ValueObject>> {
        - value : UUID
    }

    class JobId <<ValueObject>> {
        - value : UUID
    }

    class Password <<ValueObject>> {
        - value : String
    }

    class Salary <<ValueObject>> {
        - min : BigDecimal
        - max : BigDecimal
        - currency : String
    }

    class Timestamp <<ValueObject>> {
        - value : Instant
    }

    interface DomainEventPublisher

    class DomainException <<abstract>>
    class ValidationException
    class NotFoundException
}

package "authentication" {

    class UserAggregate <<Aggregate>> {
        - id : UserId
        - username : Username
        - email : Email
        - password : HashedPassword
        - active : boolean
        - emailVerified : boolean
        - createdAt : Timestamp
        - updatedAt : Timestamp
        - roles : List<String>
        - domainEvents : List<DomainEvent>
        + create() : UserAggregate
        + activate()
        + deactivate()
        + verifyEmail()
        + addRole()
    }

    class Username <<ValueObject>> {
        - value : String
    }

    class HashedPassword <<ValueObject>> {
        - value : String
    }

    class UserRegisteredEvent <<Event>> {
        - userId : String (heredado)
        - aggregatedType : String (heredado)
        - email : String
    }

    class UserActivatedEvent <<Event>> {
        - userId : String (heredado)
        - aggregatedType : String (heredado)
        - email : String
    }

    interface RegisterUserPort <<In Port>>
    interface LoginPort <<In Port>>
    interface SaveUserPort <<Out Port>>
    interface LoadUserPort <<Out Port>>
    interface PasswordEncoderPort <<Out Port>>
    interface TokenGeneratorPort <<Out Port>>

    class RegisterUserUseCase
    class LoginUseCase
    class CredentialsVerifier <<Domain Service>>
}

package "jobs" {

    class JobAggregate <<Aggregate>> {
        - id : JobId
        - title : String
        - description : String
        - company : String
        - location : String
        - salary : Salary
        - employmentType : EmploymentType
        - status : JobStatus
        - skills : List<String>
        - createdAt : Timestamp
        - updatedAt : Timestamp
        - domainEvents : List<DomainEvent>
        + create() : JobAggregate
        + close()
        + deactivate()
        + addSkill()
    }

    class Salary <<ValueObject>>

    enum EmploymentType {
        FULL_TIME
        PART_TIME
        CONTRACT
        FREELANCE
        INTERNSHIP
    }

    enum JobStatus {
        OPEN
        CLOSED
        DRAFT
        EXPIRED
        INACTIVE
    }

    class JobClosedEvent <<Event>> {
        - jobId : String (heredado)
        - aggregatedType : String (heredado)
        - jobTitle : String
        - company : String
    }

    class JobDeactivatedEvent <<Event>> {
        - jobId : String (heredado)
        - aggregatedType : String (heredado)
        - jobTitle : String
    }
}

' Composicion (*)
UserAggregate *-- UserId
UserAggregate *-- Username
UserAggregate *-- Email
UserAggregate *-- HashedPassword
UserAggregate *-- Timestamp

JobAggregate *-- JobId
JobAggregate *-- Salary
JobAggregate *-- EmploymentType
JobAggregate *-- JobStatus
JobAggregate *-- Timestamp

' Herencia (<|--)
DomainEvent <|-- UserRegisteredEvent
DomainEvent <|-- UserActivatedEvent
DomainEvent <|-- JobClosedEvent
DomainEvent <|-- JobDeactivatedEvent

DomainException <|-- ValidationException
DomainException <|-- NotFoundException

' Realizacion (<|..)
RegisterUserPort <|.. RegisterUserUseCase
LoginPort <|.. LoginUseCase

' Dependencia (<--)
SaveUserPort <-- RegisterUserUseCase
LoadUserPort <-- LoginUseCase
PasswordEncoderPort <-- RegisterUserUseCase
PasswordEncoderPort <-- LoginUseCase
TokenGeneratorPort <-- LoginUseCase

CredentialsVerifier --> PasswordEncoderPort

DomainEventPublisher <-- RegisterUserUseCase

@enduml