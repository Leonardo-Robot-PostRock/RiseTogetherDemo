@startuml UcRegister

title Authentication — RegisterUserUseCase

skinparam activityBackgroundColor #FAFAFA
skinparam activityBorderColor #888888
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityArrowColor #555555
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

start

:Email.of(command.email())\nUsername.of(command.username());

:QueryUserPort.existsByEmail(email);
note right
  CQRS — query side.
  Solo verifica duplicado.
  No instancia UserAggregate.
end note

if (¿email ya existe?) then (sí)
  #FF8A80:throw UserAlreadyExistsException;
  stop
endif

:PasswordEncoderPort.encode(rawPassword);

:UserAggregate.create(\n  username, email, hashedPassword);
note right
  Asigna ROLE_USER.
  Genera VerificationToken.
  Registra UserRegisteredEvent.
end note

:SaveUserPort.save(user);

:LoadTermsDocumentPort\n.findLatestByType(TERMS_OF_SERVICE);

:TermsAcceptance.create(userId, documentId);

:SaveTermsAcceptancePort.save(acceptance);

:DomainEventPublisher\n.publish(UserRegisteredEvent);
note right
  UserRegisteredEventListener:
  envía email de verificación
  con el token generado.
end note

:Retornar RegisterUserResponse\n(userId, username, email);

stop

@enduml
