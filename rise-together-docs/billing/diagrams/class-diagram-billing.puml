@startuml
skinparam linetype ortho

title Billing Bounded Context

package "domain" {
  class SubscriptionPlanAggregate {
    +create()
    +updateLimits()
    +activate()
    +deactivate()
  }

  class SubscriptionAggregate {
    +subscribe()
    +cancel()
    +renew()
    +upgrade()
    +downgrade()
  }

  class PaymentAggregate {
    +create()
    +markCompleted()
    +markFailed()
    +refund()
  }

  class FeatureValidator {
    +canPublishJob()
    +canFeatureJob()
    +canExport()
    +canViewMatchDetails()
  }
}

package "valueobjects" {
  class PlanId
  class PlanName <<enumeration>>
  class SubscriptionId
  class SubscriptionStatus <<enumeration>>
  class BillingCycle <<enumeration>>
  class PaymentId
  class PaymentStatus <<enumeration>>
  class FeatureLimits
}

package "events" {
  class SubscriptionActivatedEvent
  class SubscriptionCancelledEvent
  class PaymentCompletedEvent
  class FeatureLimitReachedEvent
}

SubscriptionPlanAggregate --> PlanId
SubscriptionPlanAggregate --> PlanName
SubscriptionPlanAggregate --> FeatureLimits
SubscriptionAggregate --> SubscriptionId
SubscriptionAggregate --> SubscriptionStatus
SubscriptionAggregate --> BillingCycle
PaymentAggregate --> PaymentId
PaymentAggregate --> PaymentStatus
FeatureValidator --> FeatureLimits

SubscriptionAggregate ..> SubscriptionActivatedEvent : records
SubscriptionAggregate ..> SubscriptionCancelledEvent : records
PaymentAggregate ..> PaymentCompletedEvent : records

@enduml