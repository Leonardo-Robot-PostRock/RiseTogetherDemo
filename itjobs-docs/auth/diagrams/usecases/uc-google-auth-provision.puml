@startuml UcGoogleAuthProvision

title GoogleAuthUseCase — Fase 2: Provisionar usuario

skinparam activityBackgroundColor #FAFAFA
skinparam activityBorderColor #888888
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityArrowColor #555555
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

start

if (¿usuario existe?) then (no — email nuevo)

    :UserAggregate.createGoogleUser()\n<i>active=true, emailVerified=true</i>;
    note right
      No requiere verificación
      de email posterior.
    end note

    :SaveUserPort.save(newUser);

    :LoadTermsDocumentPort\n.findLatestByType(TERMS_OF_SERVICE);

    :TermsAcceptance.create(userId, documentId);

    :SaveTermsAcceptancePort.save(acceptance);
    note right
      Registra que el usuario aceptó
      los términos al momento del
      registro.
    end note

else (sí — googleSub null)

    :user.linkGoogleAccount(googleSub);
    note right
      Dispara GoogleAccountLinkedEvent.
      No requiere aceptar términos
      nuevamente.
    end note

    :SaveUserPort.save(linkedUser);

endif

stop

@enduml
