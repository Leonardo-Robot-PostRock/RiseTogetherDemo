@startuml AuthOverview

title Authentication — Capas Hexagonales (visión de componentes)

left to right direction

skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #AAAAAA
}

rectangle "**REST Adapters**\n(Driving)" #E8EAF6 {
    rectangle "AuthController\n/api/v1/auth/**" as CTRL1
    rectangle "AccountController\n/api/v1/account/**" as CTRL2
}

rectangle "**Ports IN**\n(interfaces)" #C8E6C9 {
    rectangle "RegisterUserPort\nLoginPort\nGoogleAuthPort\nVerifyEmailPort\nForgotPasswordPort\nChangePasswordPort" as PORTS_IN
}

rectangle "**Use Cases**\n(implementan Ports IN)" #DCEDC8 {
    rectangle "RegisterUserUseCase\nLoginUseCase\nGoogleAuthUseCase\nVerifyEmailUseCase\nForgotPasswordUseCase\nChangePasswordUseCase" as UCS
}

rectangle "**Domain**" #FFF3E0 {
    rectangle "UserAggregate\nCredentialsVerifier" as DOM
}

rectangle "**Ports OUT**\n(interfaces)" #A5D6A7 {
    rectangle "LoadUserPort\nSaveUserPort\nPasswordEncoderPort\nTokenGeneratorPort\nDomainEventPublisher" as PORTS_OUT
}

rectangle "**Infrastructure Adapters**\n(Driven)" #F3E5F5 {
    rectangle "LoadUserPortAdapter (JPA)\nSaveUserPortAdapter (JPA)\nBCryptPasswordEncoderAdapter\nJwtTokenGeneratorAdapter\nSpringDomainEventPublisher" as ADAPTERS
}

CTRL1 --> PORTS_IN : invoca
CTRL2 --> PORTS_IN : invoca
PORTS_IN --> UCS : implementado por
UCS --> DOM : usa
UCS --> PORTS_OUT : invoca
PORTS_OUT --> ADAPTERS : implementado por

note bottom
  Ver auth-usecases-write.puml y auth-usecases-auth.puml
  para detalle de puertos por caso de uso.
  Ver seq-*.puml para flujos completos.
end note

@enduml
