@startuml ITJobsClassDiagram

' ══════════════════════════════════════════════════════════
'  DEPRECADO: use los diagramas separados por bounded context
'    - class-diagram-shared.puml
'    - class-diagram-auth.puml
'    - class-diagram-jobs.puml
' ══════════════════════════════════════════════════════════

title ITJobs - Diagrama de Clases DDD (consolidado)

left footer Leyenda: Composicion (*) | Herencia (<|--) | Realizacion (<|..) | Dependencia (<--)

package "shared" {

    class DomainEvent <<abstract>> {
        - occurredOn : Instant
    }

    class Email <<ValueObject>> {
        - value : String
    }

    class UserId <<ValueObject>> {
        - value : UUID
    }

    class JobId <<ValueObject>> {
        - value : UUID
    }

    class Password <<ValueObject>> {
        - value : String
    }

    class GoogleSub <<ValueObject>> {
        - value : String
    }

    class Salary <<ValueObject>> {
        - min : BigDecimal
        - max : BigDecimal
        - currency : String
    }

    class Timestamp <<ValueObject>> {
        - value : Instant
    }

    interface DomainEventPublisher

    class DomainException <<abstract>>
    class ValidationException
    class NotFoundException
}

package "authentication" {

    class UserAggregate <<Aggregate>> {
        - active : boolean
        - emailVerified : boolean
        - verificationToken : VerificationToken
        - roles : List<String>
        + create() : UserAggregate
        + createGoogleUser() : UserAggregate
        + activate()
        + deactivate()
        + verifyEmail()
        + changePassword(hashed)
        + linkGoogleAccount(sub)
        + updateEmail(email)
        + addRole(role)
    }

    class Username <<ValueObject>> {
        - value : String
    }

    class HashedPassword <<ValueObject>> {
        - value : String
    }

    class UserRegisteredEvent <<Event>> {
        - userId : String (heredado)
        - aggregatedType : String (heredado)
        - email : String
    }

    class UserActivatedEvent <<Event>> {
        - userId : String (heredado)
        - aggregatedType : String (heredado)
        - email : String
    }

    class UserDeactivatedEvent <<Event>> {
        - userId : String (heredado)
        - aggregatedType : String (heredado)
        - email : String
    }

    class EmailVerifiedEvent <<Event>> {
        - userId : String (heredado)
        - aggregatedType : String (heredado)
        - email : String
    }

    class PasswordResetRequestedEvent <<Event>> {
        - userId : String (heredado)
        - aggregatedType : String (heredado)
        - email : String
        - resetToken : String
    }

    interface RegisterUserPort <<In Port>>
    interface LoginPort <<In Port>>
    interface ChangePasswordPort <<In Port>>
    interface ForgotPasswordPort <<In Port>>
    interface GoogleAuthPort <<In Port>>
    interface VerifyEmailPort <<In Port>>
    interface SaveUserPort <<Out Port>>
    interface LoadUserPort <<Out Port>>
    interface PasswordEncoderPort <<Out Port>>
    interface TokenGeneratorPort <<Out Port>>

    class RegisterUserUseCase
    class LoginUseCase
    class ChangePasswordUseCase
    class ForgotPasswordUseCase
    class GoogleAuthUseCase
    class VerifyEmailUseCase
    class CredentialsVerifier <<Domain Service>>
}

package "jobs" {

    class JobAggregate <<Aggregate>> {
        - id : JobId
        - title : String
        - description : String
        - company : String
        - location : String
        - salary : Salary
        - employmentType : EmploymentType
        - status : JobStatus
        - skills : List<String>
        - createdAt : Timestamp
        - updatedAt : Timestamp
        - domainEvents : List<DomainEvent>
        + create() : JobAggregate
        + close()
        + deactivate()
        + addSkill()
    }

    class Salary <<ValueObject>>

    enum EmploymentType {
        FULL_TIME
        PART_TIME
        CONTRACT
        FREELANCE
        INTERNSHIP
    }

    enum JobStatus {
        OPEN
        CLOSED
        DRAFT
        EXPIRED
        INACTIVE
    }

    class JobClosedEvent <<Event>> {
        - jobId : String (heredado)
        - aggregatedType : String (heredado)
        - jobTitle : String
        - company : String
    }

    class JobDeactivatedEvent <<Event>> {
        - jobId : String (heredado)
        - aggregatedType : String (heredado)
        - jobTitle : String
    }
}

' Composicion (*)
UserAggregate *-- UserId
UserAggregate *-- Username
UserAggregate *-- Email
UserAggregate *-- HashedPassword
UserAggregate *-- GoogleSub
UserAggregate *-- Timestamp

JobAggregate *-- JobId
JobAggregate *-- Salary
JobAggregate *-- EmploymentType
JobAggregate *-- JobStatus
JobAggregate *-- Timestamp

' Herencia (<|--)
DomainEvent <-- UserRegisteredEvent
DomainEvent <-- UserActivatedEvent
DomainEvent <-- UserDeactivatedEvent
DomainEvent <-- EmailVerifiedEvent
DomainEvent <-- PasswordResetRequestedEvent
DomainEvent <-- JobClosedEvent
DomainEvent <-- JobDeactivatedEvent

DomainException <-- ValidationException
DomainException <|-- NotFoundException

' Realizacion (<|..)
RegisterUserPort <.. RegisterUserUseCase
LoginPort <.. LoginUseCase
ChangePasswordPort <.. ChangePasswordUseCase
ForgotPasswordPort <.. ForgotPasswordUseCase
GoogleAuthPort <.. GoogleAuthUseCase
VerifyEmailPort <.. VerifyEmailUseCase

' Dependencia (<--)
SaveUserPort <-- RegisterUserUseCase
SaveUserPort <-- VerifyEmailUseCase
SaveUserPort <-- GoogleAuthUseCase
SaveUserPort <-- ChangePasswordUseCase
LoadUserPort <-- LoginUseCase
LoadUserPort <-- ForgotPasswordUseCase
LoadUserPort <-- VerifyEmailUseCase
LoadUserPort <-- GoogleAuthUseCase
LoadUserPort <-- ChangePasswordUseCase
PasswordEncoderPort <-- RegisterUserUseCase
PasswordEncoderPort <-- ChangePasswordUseCase
TokenGeneratorPort <-- LoginUseCase
TokenGeneratorPort <-- GoogleAuthUseCase

CredentialsVerifier --> PasswordEncoderPort
ChangePasswordUseCase --> CredentialsVerifier
LoginUseCase --> CredentialsVerifier

DomainEventPublisher <-- RegisterUserUseCase
DomainEventPublisher <-- ForgotPasswordUseCase
DomainEventPublisher <-- VerifyEmailUseCase

@enduml