@startuml ITJobs - Secuencia: Refresh Token

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Usuario" as U
participant "AuthController\n<<REST>>" as CTRL
participant "RefreshTokenUseCase\n<<Use Case>>" as UC
participant "TokenGeneratorPort\n<<Out Port>>" as TOKEN
participant "QueryUserPort\n<<Out Port>>" as QUERY

U -> CTRL : POST /api/v1/auth/refresh\n{refreshToken}
activate CTRL

CTRL -> UC : execute(command)
activate UC

' Validar el refresh token y extraer userId
UC -> TOKEN : validateRefreshToken(refreshToken)
activate TOKEN
TOKEN --> UC : userId (extraído del JWT)
deactivate TOKEN

note right of TOKEN
  JwtTokenGeneratorAdapter:
  Verifica firma y expiración del refresh token.
  Si inválido → throws InvalidCredentialsException.
end note

' Verificar que el usuario sigue activo
UC -> QUERY : findById(userId)
activate QUERY
QUERY --> UC : Optional<UserView>
deactivate QUERY

UC -> UC : orElseThrow() → usuario no encontrado
UC -> UC : verifica view.active() = true

note right of QUERY
  CQRS — query side.
  Solo necesita verificar que el usuario
  existe y está activo.
  Devuelve UserView (no UserAggregate).
end note

' Generar nuevo par de tokens
UC -> TOKEN : generateAccessToken(userId, roles)
activate TOKEN
TOKEN --> UC : "eyJhbG..."
deactivate TOKEN

UC -> TOKEN : generateRefreshToken(userId)
activate TOKEN
TOKEN --> UC : "eyJhbG..."
deactivate TOKEN

UC --> CTRL : AuthTokenResponse
deactivate UC

CTRL --> U : 200 OK\n{accessToken, refreshToken}
deactivate CTRL

@enduml

