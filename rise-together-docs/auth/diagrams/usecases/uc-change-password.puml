@startuml UcChangePassword

title Authentication — ChangePasswordUseCase

skinparam activityBackgroundColor #FAFAFA
skinparam activityBorderColor #888888
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityArrowColor #555555
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

start

:UserId.of(command.userId());

:LoadUserPort.findById(userId);
note right
  CQRS — command side.
  Devuelve Optional<UserAggregate>.
end note

if (¿usuario encontrado?) then (no)
  #FF8A80:throw NotFoundException;
  stop
endif

:CredentialsVerifier.verifyCredentials(\n  user, command.oldPassword(), passwordEncoder);
note right
  Delega en PasswordEncoderPort.matches().
  Lanza InvalidCredentialsException
  si la contraseña actual no coincide.
end note

:PasswordEncoderPort.encode(command.newPassword());

:user.changePassword(HashedPassword.fromHash(newHash));
note right
  Actualiza password + updatedAt.
  Registra PasswordChangedEvent.
end note

:SaveUserPort.save(user);

stop

@enduml
