@startuml
skinparam linetype ortho

title Profiles Bounded Context

package "domain" {
  class CandidateAggregate {
    +create()
    +updateProfile()
    +addSkill()
    +removeSkill()
  }

  class EmployerAggregate {
    +create()
    +updateProfile()
    +setLogo()
    +setType()
  }

  class RecruiterAggregate {
    +create()
    +associateToEmployer()
    +removeAssociation()
  }

  class FreelancerProfile {
    +create()
    +updateProfile()
    +setHourlyRate()
  }
}

package "valueobjects" {
  class CandidateId
  class EmployerId
  class ProficiencyLevel <<enumeration>>
  class RequirementLevel <<enumeration>>
  class EmployerType <<enumeration>>
  class CompanySize <<enumeration>>
  class Availability <<enumeration>>
}

package "events" {
  class CandidateProfileCreatedEvent
  class EmployerProfileUpdatedEvent
  class RecruiterAssociatedEvent
}

CandidateAggregate --> CandidateId
EmployerAggregate --> EmployerId
EmployerAggregate --> EmployerType
EmployerAggregate --> CompanySize
CandidateAggregate --> ProficiencyLevel
CandidateAggregate --> RequirementLevel
FreelancerProfile --> Availability
FreelancerProfile --> EmployerId

CandidateAggregate ..> CandidateProfileCreatedEvent : records
EmployerAggregate ..> EmployerProfileUpdatedEvent : records
RecruiterAggregate ..> RecruiterAssociatedEvent : records

@enduml