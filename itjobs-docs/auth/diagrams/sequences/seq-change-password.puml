@startuml ITJobs - Secuencia: Cambio de Contraseña

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Usuario Autenticado" as U
participant "AccountController\n<<REST>>" as CTRL
participant "ChangePasswordUseCase\n<<Use Case>>" as UC
participant "LoadUserPort\n<<Out Port>>" as LOAD
participant "CredentialsVerifier\n<<Domain Service>>" as VER
participant "PasswordEncoderPort\n<<Out Port>>" as ENC
participant "UserAggregate\n<<Aggregate>>" as AGG
participant "SaveUserPort\n<<Out Port>>" as SAVE

U -> CTRL : POST /api/v1/account/change-password\nAuthorization: Bearer <token>\n{oldPassword, newPassword}
activate CTRL

CTRL -> CTRL : Extraer userId del JWT (SecurityContext)
CTRL -> CTRL : Map DTO → ChangePasswordCommand(userId, oldPassword, newPassword)

CTRL -> UC : execute(command)
activate UC

' Cargar usuario
UC -> LOAD : findById(UserId.of(command.userId()))
activate LOAD
LOAD --> UC : Optional<UserAggregate>
deactivate LOAD

UC -> UC : orElseThrow()\nUsuario no encontrado → 400

' Verificar password actual
UC -> VER : verifyCredentials(user, command.oldPassword(), passwordEncoder)
activate VER
VER -> ENC : matches(oldPassword, user.password.value())
activate ENC
ENC --> VER : true / false
deactivate ENC
VER -> VER : false → InvalidCredentialsException
VER --> UC : void (credenciales válidas)
deactivate VER

' Hashear nuevo password
UC -> ENC : encode(command.newPassword())
activate ENC
ENC --> UC : "$2a$10$newHash..."
deactivate ENC

' Actualizar en el agregado
UC -> AGG : user.changePassword(HashedPassword.fromHash(newHash))
activate AGG
AGG -> AGG : this.password = HashedPassword
AGG -> AGG : this.updatedAt = Timestamp.now()
AGG --> UC : void
deactivate AGG

' Persistir
UC -> SAVE : save(user)
activate SAVE
SAVE --> UC : void
deactivate SAVE

UC --> CTRL : void
deactivate UC

CTRL --> U : 200 OK
deactivate CTRL

@enduml

