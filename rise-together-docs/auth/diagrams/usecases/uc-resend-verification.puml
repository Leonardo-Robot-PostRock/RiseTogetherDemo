@startuml UcResendVerification

title Authentication — ResendVerificationUseCase

skinparam activityBackgroundColor #FAFAFA
skinparam activityBorderColor #888888
skinparam activityDiamondBackgroundColor #FFF9C4
skinparam activityArrowColor #555555
skinparam noteBackgroundColor #FFFDE7
skinparam noteBorderColor #F9A825

start

:UserId.of(command.userId());

:LoadUserPort.findById(userId);
note right
  CQRS — command side.
  Devuelve Optional<UserAggregate>.
end note

if (¿usuario encontrado?) then (no)
  #FF8A80:throw NotFoundException;
  stop
endif

if (¿emailVerified = true?) then (sí)
  #FF8A80:throw EmailAlreadyVerifiedException;
  stop
endif

:Generar nuevo VerificationToken\n(uuid, expiresAt = now + 24h);

:SaveUserPort.save(user);

:EmailSenderPort\n.sendEmail(email, subject, body);
note right
  SmtpEmailSenderAdapter si
  spring.mail.host está configurado.
  NoOpEmailSenderAdapter como fallback
  (logs WARN, no lanza excepción).
end note

stop

@enduml
