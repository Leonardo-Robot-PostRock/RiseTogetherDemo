@startuml ITJobs - Secuencia: Recuperación de Contraseña

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Usuario" as U
participant "AuthController\n<<REST>>" as CTRL
participant "ForgotPasswordUseCase\n<<Use Case>>" as UC
participant "LoadUserPort\n<<Out Port>>" as LOAD
participant "DomainEventPublisher\n<<Out Port>>" as PUB

note over CTRL
  PENDIENTE: endpoint no está
  conectado aún al controller
end note

U -> CTRL : POST /api/v1/auth/forgot-password\n{email}
activate CTRL

CTRL -> CTRL : Map DTO → ForgotPasswordCommand

CTRL -> UC : execute(command)
activate UC

UC -> UC : Email.of(command.email())

' Buscar usuario por email
UC -> LOAD : findByEmail(email)
activate LOAD
LOAD --> UC : Optional<UserAggregate>
deactivate LOAD

alt Usuario NO encontrado
    note over UC
      Por seguridad, no se revela si el email
      existe o no. Se retorna silenciosamente.
    end note
    UC --> CTRL : void (sin error)
else Usuario encontrado
    UC -> UC : generateResetToken()\n→ UUID.randomUUID().toString()

    UC -> PUB : publishAll([PasswordResetRequestedEvent(\n  userId, email, resetToken)])
    activate PUB
    note right of PUB
      El listener del evento es responsable
      de enviar el email con el enlace de
      restablecimiento (implementación futura)
    end note
    PUB --> UC : void
    deactivate PUB

    UC --> CTRL : void
end

deactivate UC

CTRL --> U : 200 OK\n(respuesta idéntica aunque email no exista)
deactivate CTRL

@enduml

