@startuml ITJobs - Secuencia: Autenticación con Google

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Usuario" as U
participant "AuthController\n<<REST>>" as CTRL
participant "GoogleAuthUseCase\n<<Use Case>>" as UC
participant "LoadUserPort\n<<Out Port>>" as LOAD
participant "SaveUserPort\n<<Out Port>>" as SAVE
participant "UserAggregate\n<<Aggregate>>" as AGG
participant "TokenGeneratorPort\n<<Out Port>>" as TOKEN

U -> CTRL : POST /api/v1/auth/login/google\n{email, googleSub, name}
activate CTRL

CTRL -> CTRL : Map DTO → GoogleAuthCommand

CTRL -> UC : execute(command)
activate UC

UC -> UC : Email.of(command.email())\nGoogleSub.of(command.googleSub())

' Buscar usuario existente
UC -> LOAD : findByEmail(email)
activate LOAD
LOAD --> UC : Optional<UserAggregate>
deactivate LOAD

alt Usuario YA existe
    UC -> UC : Verificar que googleSub coincide\n(si ya tenía googleSub diferente → InvalidCredentialsException)
    note right of UC
      Seguridad: evita que alguien con
      el mismo email de una cuenta
      diferente tome el control
    end note
else Usuario NO existe → crear cuenta Google
    UC -> AGG : UserAggregate.createGoogleUser(\n  username, email, password, googleSub)
    activate AGG
    AGG -> AGG : active = true\nemailVerified = true\ngoogleSub = googleSub
    AGG --> UC : UserAggregate (sin eventos)
    deactivate AGG

    UC -> SAVE : save(newUser)
    activate SAVE
    SAVE --> UC : savedUser
    deactivate SAVE
end

' Generar tokens
UC -> TOKEN : generateAccessToken(userId, roles)
activate TOKEN
TOKEN --> UC : "eyJhbG..."
deactivate TOKEN

UC -> TOKEN : generateRefreshToken(userId)
activate TOKEN
TOKEN --> UC : "eyJhbG..."
deactivate TOKEN

UC --> CTRL : AuthTokenResponse(userId, username, email, accessToken, refreshToken)
deactivate UC

CTRL -> CTRL : Map → AuthResponse
CTRL --> U : 200 OK\n{accessToken, refreshToken}
deactivate CTRL

@enduml

